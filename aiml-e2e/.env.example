# Copy this file to .env and adjust. .env is NOT version controlled.
# All values are optional - defaults are shown.

# Project root (default: folder that contains pyproject.toml)
# PROJECT_ROOT=

# Paths (relative paths are resolved against PROJECT_ROOT)
RAW_DATA=data/raw/loan_applications_raw.csv
SAMPLE_DATA=data/sample/sample_applicants.csv
PROCESSED_DATA=data/processed
REPORTS_DIR=reports
MODEL_DIR=models
LOG_DIR=logs

# Runtime
LOG_LEVEL=INFO
RANDOM_STATE=51

# Secret used to sign model metadata (HMAC-SHA256). Change it - never commit real keys.
MODEL_SIGNING_KEY=change-me-to-a-long-random-string

# API server (python -m northwind_loans.api / make serve)
API_HOST=0.0.0.0
API_PORT=8000

# Grafana admin password (docker compose)
GRAFANA_ADMIN_PASSWORD=change-me
