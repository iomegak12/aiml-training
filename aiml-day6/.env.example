# Copy to .env and fill in your key. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.1                          # LLM for hybrid corpus prose
OPENAI_REASONING_EFFORT=low                   # none | low | medium | high (low is ~8x faster than high)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small # embedding model for the vector stores

# --- Pre-RAG ingestion (scripts/ingest_vector_stores.py) ---
VECTORSTORE_DIR=data/vectorstores             # parent folder of the two Chroma databases
HR_COLLECTION_NAME=hr_policies                # also the HR database folder name
PRODUCT_COLLECTION_NAME=product_manuals       # also the product database folder name
HR_CHUNK_SIZE=800                             # characters per chunk, HR policies
HR_CHUNK_OVERLAP=120
PRODUCT_CHUNK_SIZE=1200                       # characters per chunk, product manuals
PRODUCT_CHUNK_OVERLAP=200
INGEST_BATCH_SIZE=4                           # PDFs prepared and embedded in parallel
EMBEDDING_BATCH_SIZE=100                      # chunks per embeddings request and per Chroma write
STRIP_HEADERS_FOOTERS=true                    # remove repeated page headers/footers before chunking
VALIDATION_SAMPLE_SIZE=3                      # sample records shown by scripts/validate_vector_stores.py

# --- Multi-agent RAG (src/agentic_rag) ---
OPENAI_FAST_MODEL=gpt-5.1                     # RAG steps (rewrite, grade, rerank), memory extraction, specialists
OPENAI_FAST_REASONING_EFFORT=low
COORDINATOR_REASONING_EFFORT=high             # Coordinator plan / reflect / synthesize (uses OPENAI_MODEL)
SPECIALIST_REASONING_EFFORT=low               # the five specialist Deep Agents (SPECIALIST_MODEL, default OPENAI_FAST_MODEL)
MAX_REPLANS=2                                 # replans after reflection, per attempt
MAX_AGENT_CALLS=8                             # specialist runs per question (all attempts)
SERPER_API_KEY=your-serper-key                # https://serper.dev - enables the Research agent
SERPER_RESULTS=5                              # results per web search
RAG_TOP_K=6                                   # passages in the answer context
RAG_CANDIDATE_K=20                            # candidates per retriever before fusion / rerank
RRF_K=60                                      # Reciprocal Rank Fusion constant
AGENT_STATE_DIR=data/agent_state              # SQLite checkpointer (short-term) + store (long-term memory)
MCP_CONFIG_PATH=config/mcp_servers.json       # MCP servers used by the agents
CRM_MCP_URL=http://localhost:8765/mcp         # CRM & Support MCP server endpoint
EVAL_SAMPLE_SIZE=20                           # golden questions per batch evaluation

# --- Judge (quality gate on the final answer) ---
JUDGE_OPENAI_MODEL=gpt-5.5                    # separate model grades the answer
JUDGE_OPENAI_API_KEY=sk-your-judge-key        # falls back to OPENAI_API_KEY when empty
JUDGE_REASONING_EFFORT=low
JUDGE_PASS_SCORE=80                           # overall score (0-100) needed to pass
JUDGE_MAX_RETRIES=3                           # retries below the pass mark, then best attempt + low-confidence flag

# --- CRM & Support MCP server (src/mcp_servers/crm_support; make mcp-server-up) ---
CRM_DB_PATH=data/crm/crm_support.db           # SQLite file (in Docker: ./data/crm is mounted at /app/data)
MCP_PORT=8765                                 # host port, published on 127.0.0.1 only (no authentication)
CRM_SEED_ON_START=true                        # load the demo customers/tickets when the database is empty
MCP_LOG_LEVEL=warning                         # debug | info | warning | error
